# Copiá este archivo a `.env` y completá los valores para tu entorno.
# `.env` NO debe commitearse (ver .gitignore).

# ─── Credenciales SQL Server ──────────────────────────────────────────────
# Password del usuario sa para Docker SQL Server efímero y AnalyticsDB.
# Mínimo 8 chars, mayúscula, número y símbolo (requisito SQL Server).
SQL_SA_PASSWORD=CambiameEnTuEnv2026!

# Host y puerto del servidor SQL Server destino para el load analítico.
# Para Docker efímero, dejar localhost:1433. Para servidor remoto, ajustar.
SQL_HOST=localhost
SQL_PORT=1433
SQL_DATABASE=AnalyticsDB
SQL_DRIVER=ODBC Driver 17 for SQL Server

# ─── Docker ───────────────────────────────────────────────────────────────
DOCKER_MEMORY=4g

# ─── Pipeline ─────────────────────────────────────────────────────────────
# Filas por chunk cuando se procesa CSV/Excel/SQL.
PIPELINE_CHUNK_SIZE=50000

# Umbral de cuarentena: si más del N% de las filas caen en cuarentena, el
# pipeline falla con exit code 2. Default 0.05 = 5%.
PIPELINE_QUARANTINE_FAIL_THRESHOLD=0.05

# Excel: filas por hoja al exportar tablas grandes (máx openpyxl: 1048576).
PIPELINE_EXCEL_ROWS_PER_SHEET=1000000

# ─── Alertas ──────────────────────────────────────────────────────────────
# Webhook URL para notificaciones de drift/cuarentena/fallo del pipeline.
# Compatible con Slack incoming webhooks (también funciona Discord/Teams).
# Si está vacío, las alertas solo van al log local.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ─── WebApp ───────────────────────────────────────────────────────────────
# Token para Bearer auth en los endpoints /upload, /download, /bigdata/*.
# Si está vacío, la UI NO requiere auth (warning al arrancar).
# Para generar un token: python -c "import secrets; print(secrets.token_urlsafe(32))"
# WEBAPP_AUTH_TOKEN=<token-aleatorio-de-32-chars>

# HTTPS local: para servir con TLS, pasar paths a uvicorn:
#   python auto_pipeline.py --ui   (ver core/webapp.py: WebApp.serve acepta ssl_*)
# Generación de cert self-signed (Windows con OpenSSL):
#   openssl req -x509 -newkey rsa:4096 -nodes -days 365 -keyout key.pem -out cert.pem -subj "/CN=localhost"
